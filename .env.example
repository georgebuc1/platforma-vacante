VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Agoda Long Tail Search API ---
# The frontend does NOT need any Agoda variable — it only calls the Supabase
# Edge Function via supabase.functions.invoke('agoda-search'), which already
# uses VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY above.
#
# Real Agoda secrets are set server-side ONLY, via the Supabase CLI, and never
# appear in this file or in any VITE_ variable:
#
#   supabase secrets set AGODA_SITE_ID=123456
#   supabase secrets set AGODA_API_KEY=00000000-0000-0000-0000-000000000000
#   supabase secrets set AGODA_API_URL=http://affiliateapi7643.agoda.com/affiliateservice/lt_v1
